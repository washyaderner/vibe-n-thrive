<section class="booking section" id="booking">
  <div class="container">
    <div class="text-center">
      <p class="section-label">Visit Us</p>
      <h2 class="section-title">Location & Booking</h2>
      <p class="section-subtitle" style="margin-left:auto;margin-right:auto;">
        We're located in Portland, Oregon. Book your session online. It only takes a minute.
      </p>
    </div>

    <div class="booking__grid">
      <div class="booking__left">
        <div class="booking__where glass">
          <div class="booking__area">
            <div class="booking__area-pin" aria-hidden="true">
              <span class="booking__area-ring"></span>
              <span class="booking__area-ring booking__area-ring--2"></span>
              <span class="booking__area-ring booking__area-ring--3"></span>
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <p class="booking__area-city">Portland, Oregon</p>
          </div>
          <div class="booking__address">
            <p><strong>Vibe'N Thrive Vibro-Acoustic Therapy</strong></p>
          </div>
        </div>

        <div class="booking__contact glass">
          <p class="booking__contact-name">Carson Goff</p>
          <div class="booking__contact-info">
            <p class="booking__phone">
              <a href="tel:+12083530597">(208) 353-0597</a>
            </p>
            <p class="booking__email">
              <button type="button" class="booking__email-btn" data-email="vibenthrivevibroacoustics@gmail.com">
                vibenthrivevibroacoustics@gmail.com
              </button>
              <span class="booking__email-copied">Copied!</span>
            </p>
          </div>
          <p class="booking__contact-message">
            If you have any questions or need specific accommodations, please feel free to reach out. Response times are typically shorter than 24hrs.
          </p>
        </div>
      </div>

      <div class="booking__calendar glass">
        <h3 class="booking__calendar-title">Book Your Session</h3>
        <p class="booking__calendar-desc">
          Select a time that works for you. Your first session includes a brief consultation.
        </p>
        <div class="booking__calendly-wrap" id="calendly-inline"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .booking__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .booking__left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .booking__where {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Service-area panel: at least the map's old footprint, and it stretches to match the calendar */
  .booking__area {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 380px;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(135deg, #e0f7f5 0%, #bae6e0 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    color: var(--color-teal);
  }

  .booking__area-pin {
    position: relative;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
  }

  .booking__area-pin svg {
    position: relative;
    z-index: 1;
  }

  /* Soft rings that ripple out from the pin, like sound moving through the table */
  .booking__area-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120px;
    height: 120px;
    border: 1px solid rgba(13, 148, 136, 0.3);
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.4);
    animation: booking-ring 4.5s ease-out infinite;
  }

  .booking__area-ring--2 {
    animation-delay: 1.5s;
  }

  .booking__area-ring--3 {
    animation-delay: 3s;
  }

  @keyframes booking-ring {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.4);
    }
    20% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(3.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .booking__area-ring {
      animation: none;
      opacity: 0.5;
      transform: translate(-50%, -50%) scale(1);
    }

    .booking__area-ring--2 {
      opacity: 0.35;
      transform: translate(-50%, -50%) scale(1.8);
    }

    .booking__area-ring--3 {
      opacity: 0.2;
      transform: translate(-50%, -50%) scale(2.6);
    }
  }

  .booking__area-city {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray-900);
    text-align: center;
  }

  .booking__address {
    padding: 1rem 1rem 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  .booking__address strong {
    color: var(--color-gray-900);
    font-size: 1rem;
  }

  .booking__contact {
    padding: 1.5rem;
  }

  .booking__contact-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-gray-900);
  }

  .booking__contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .booking__contact-message {
    font-size: 0.8125rem;
    color: var(--color-gray-700);
    line-height: 1.6;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-gray-100);
  }

  .booking__phone a {
    color: var(--color-gray-900);
    font-weight: 500;
    font-size: 1rem;
    text-decoration: none;
  }

  .booking__phone a:hover {
    text-decoration: underline;
  }

  .booking__email {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .booking__email-btn {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-gray-900);
    font-weight: 500;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
  }

  .booking__email-btn:hover {
    text-decoration: underline;
  }

  .booking__email-copied {
    font-size: 0.75rem;
    color: var(--color-teal);
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .booking__email-copied.show {
    opacity: 1;
  }

  .booking__calendar {
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .booking__calendar-title {
    margin-bottom: 0.5rem;
  }

  .booking__calendar-desc {
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    margin-bottom: 1.5rem;
  }

  .booking__calendly-wrap {
    border-radius: 16px;
    overflow: hidden;
    flex: 1;
    min-height: 600px;
  }

  .booking__calendly-wrap iframe {
    height: 100% !important;
    min-height: 100% !important;
  }

  @media (max-width: 900px) {
    .booking__grid {
      grid-template-columns: 1fr;
    }

    .booking__calendly-wrap {
      min-height: 660px;
    }

    .booking__area {
      min-height: 280px;
    }

    .booking__area-city {
      font-size: 1.5rem;
    }

    .booking__email-btn {
      font-size: 0.8125rem;
      word-break: break-all;
    }
  }

  @media (max-width: 400px) {
    .booking__area-city {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  // Calendly: eagerly load CSS + JS, init widget on scroll
  const calendlyContainer = document.getElementById('calendly-inline');

  if (calendlyContainer) {
    // Load CSS + JS immediately so they're cached by scroll time
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://assets.calendly.com/assets/external/widget.css';
    document.head.appendChild(link);

    const calendlyReady = new Promise((resolve) => {
      const script = document.createElement('script');
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      script.onload = resolve;
      document.head.appendChild(script);
    });

    // Only init the widget when section is near viewport
    const calObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          calendlyReady.then(() => {
            window.Calendly.initInlineWidget({
              url: 'https://calendly.com/vibenthrivevibroacoustics/60-min-session?hide_event_type_details=1&hide_gdpr_banner=1',
              parentElement: calendlyContainer,
            });
          });
          calObserver.disconnect();
        }
      });
    }, { rootMargin: '800px' });

    calObserver.observe(calendlyContainer);
  }

  const emailBtn = document.querySelector('.booking__email-btn');
  const copiedMsg = document.querySelector('.booking__email-copied');

  emailBtn?.addEventListener('click', async () => {
    const email = emailBtn.getAttribute('data-email');
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      copiedMsg?.classList.add('show');
      setTimeout(() => {
        copiedMsg?.classList.remove('show');
      }, 2000);
    } catch (err) {
      // Fallback for older browsers
      const textArea = document.createElement('textarea');
      textArea.value = email;
      textArea.style.position = 'fixed';
      textArea.style.opacity = '0';
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand('copy');
      document.body.removeChild(textArea);
      copiedMsg?.classList.add('show');
      setTimeout(() => {
        copiedMsg?.classList.remove('show');
      }, 2000);
    }
  });
</script>
